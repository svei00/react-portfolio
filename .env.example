# Copy this file to .env.local (gitignored) and fill in real values.
# Never commit real secrets — see handoff.md finding S1 for why this matters.

# EmailJS (dashboard: https://dashboard.emailjs.com)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Private key: Account > Security > "Allow EmailJS API for non-browser
# applications" must be enabled first, or server-side sends will be rejected.
EMAILJS_PRIVATE_KEY=

# Sanity CMS (https://www.sanity.io/manage > project "portfolio"). Both values
# are PUBLIC (they appear in every Sanity URL), so the NEXT_PUBLIC_ prefix is
# intentional. There is NO Sanity token for the website: it only reads
# published content from a public dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=b0kesagv
NEXT_PUBLIC_SANITY_DATASET=production
# Optional. A date; defaults to 2026-10-01 in src/sanity/env.ts.
# NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Webhook secret (phase 4.6): the same random string goes in sanity.io/manage >
# API > Webhooks and here. Server-only: no NEXT_PUBLIC_ prefix.
# SANITY_REVALIDATE_SECRET=
